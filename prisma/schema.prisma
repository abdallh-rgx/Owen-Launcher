// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ---------------------------------------------------------------------------
// Owen Launcher Web Console (Task 24)
// ---------------------------------------------------------------------------

/// Singleton owen.json configuration (row id = 1).
model RedirecterConfig {
  id         Int      @id @default(1)
  configJson String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

/// Derived extra_rules rows from the owen.json redirect section.
model RedirectRule {
  id          String   @id @default(cuid())
  match       String
  replacePath String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Backend server profiles.
model ServerProfile {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String
  backend   String   @default("lawin-v2")
  features  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Access keys (replaces the classic Discord bot admin panel).
model KeyEntry {
  id        String    @id @default(cuid())
  key       String    @unique
  role      String    @default("player")
  note      String    @default("")
  revoked   Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())
}

/// Imported battle pass season reward data.
model SeasonRecord {
  id           String   @id @default(cuid())
  seasonNumber Int      @unique
  displayName  String
  dataJson     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Symbol Finder scan history.
model ScanRecord {
  id        String   @id @default(cuid())
  fileName  String
  bestVa    String?
  score     Int      @default(0)
  variadic  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Owen Control Room — human-in-the-loop emulator annotation (Task 33)
// ---------------------------------------------------------------------------
// The GitHub Actions driver (emulator-control.yml) posts a screenshot here as
// a PENDING ControlTask; the human clicks the button location on the site,
// describes it and sets a wait; the driver polls the answer, taps the
// emulator and marks the task APPLIED (with an "after" screenshot).

/// One annotation request: "where is the button on this screenshot?".
model ControlTask {
  id           String    @id @default(cuid())
  seq          Int       @unique
  stepKey      String    @default("step")
  title        String
  instruction  String
  /// PENDING | ANSWERED | APPLIED | FAILED | CANCELLED
  status       String    @default("PENDING")
  /// tap | swipe | wait | back | home | done | skip (user's answer)
  action       String?
  x            Float?
  y            Float?
  x2           Float?
  y2           Float?
  description  String?
  waitMs       Int?
  imageName    String?
  afterName    String?
  imageW       Int?
  imageH       Int?
  imageVersion Int       @default(1)
  wantsRetake  Boolean   @default(false)
  /// JSON string with driver context (current app, focus window, uptime…)
  meta         String?
  error        String?
  answeredAt   DateTime?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Singleton (id = 1) driver heartbeat, refreshed every ~20s by the runner.
model ControlHeartbeat {
  id        Int      @id @default(1)
  state     String   @default("BOOT")
  phase     String   @default("")
  device    String   @default("")
  message   String   @default("")
  logTail   String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Manual operator signals: download_done | start_sdk | restart_app |
/// crash_report | note — created from the site, consumed + acked by the driver.
model ControlSignal {
  id        String    @id @default(cuid())
  seq       Int       @unique
  type      String
  note      String    @default("")
  /// PENDING | ACK
  status    String    @default("PENDING")
  /// Driver's ack result text (what it did with the signal)
  result    String?
  createdAt DateTime  @default(now())
  ackedAt   DateTime?
}
